{
  "name": "sitelog",
  "version": "0.1.0",
  "private": true,
  "description": "Daily site reporting and management dashboard for Tihama Limited (Constructions), Kano",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "npm --prefix web ci && npm --prefix web run build",
    "deploy:build": "npm ci && npm run build && npm run migrate",
    "migrate": "node scripts/migrate.js",
    "seed": "node src/db/seed.js",
    "create-user": "node scripts/create-user.js",
    "list-sites": "node scripts/list-sites.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=18"
  }
}
